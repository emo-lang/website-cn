package layouts

import (
	"github.com/daqing/airway/app/assets"
	"github.com/daqing/airway/lib/utils"

	"github.com/emo-lang/website-cn/app/views/emocode"
)

// Base renders the shared HTML document shell. Page templates wrap their
// content in this component, e.g.:
//
//	@layouts.Base("My Title") {
//		<p>Page body…</p>
//	}
templ Base(title string, description ...string) {
	<!DOCTYPE html>
	<html lang="zh-CN">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="icon" type="image/png" href={ templ.URL(utils.URLPrefix() + "/public/logo.png") }/>
			if len(description) > 0 {
				<meta name="description" content={ description[0] }/>
				<meta property="og:title" content={ title }/>
				<meta property="og:description" content={ description[0] }/>
				<meta property="og:type" content="website"/>
				<meta name="theme-color" content="#202022"/>
			}
			@SiteStyles()
			@emocode.Styles()
			@assets.Stylesheet()
			if utils.AppConfig().IsLocal {
				<script src={ templ.URL(utils.URLPrefix() + "/assets/livereload.js") } data-ws={ utils.URLPrefix() + "/ws" } defer></script>
			}
			@assets.Scripts()
		</head>
		<body>
			{ children... }
		</body>
	</html>
}
