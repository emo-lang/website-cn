package layouts

// SiteStyles renders the Emo brand design system shared by every page:
// Yellow #EFBF6B · Dark #202022 · Grey #F9FAFC · Blue #7678ED.
templ SiteStyles() {
	<style>
		:root {
			--bg: #F9FAFC;
			--surface: #ffffff;
			--text: #202022;
			--muted: #5f5f66;
			--border: #e4e6ea;
			--brand: #EFBF6B;
			--brand-ink: #4a3413;
			--brand-strong: #8a6a1d;
			--blue: #7678ED;
			--blue-strong: #5356d3;
			--code-bg: #f0f1f4;
			--shadow: 0 1px 2px rgba(32, 32, 34, 0.06), 0 4px 16px rgba(32, 32, 34, 0.05);
			--mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
			color-scheme: light;
		}
		@media (prefers-color-scheme: dark) {
			:root {
				--bg: #202022;
				--surface: #28282b;
				--text: #ececef;
				--muted: #a0a0a8;
				--border: #3a3a3f;
				--brand: #EFBF6B;
				--brand-ink: #4a3413;
				--brand-strong: #EFBF6B;
				--blue: #9ea0f5;
				--blue-strong: #b3b5f8;
				--code-bg: #2b2b2e;
				--shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 4px 16px rgba(0, 0, 0, 0.3);
				color-scheme: dark;
			}
		}

		* { box-sizing: border-box; }
		html { scroll-behavior: smooth; scroll-padding-top: 5rem; }
		body {
			position: relative;
			margin: 0;
			padding: 0;
			background: var(--bg);
			color: var(--text);
			font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
			font-size: 1.0625rem;
			line-height: 1.75;
			-webkit-font-smoothing: antialiased;
			text-rendering: optimizeLegibility;
		}
		::selection { background: var(--brand); color: #202022; }
		a { color: var(--blue-strong); text-decoration: none; }
		a:hover { text-decoration: underline; text-underline-offset: 3px; }
		code {
			font-family: var(--mono);
			font-size: 0.88em;
			background: var(--code-bg);
			border-radius: 0.35rem;
			padding: 0.15em 0.4em;
		}

		/* ------------------------------------------------------------ nav -- */
		.site-nav {
			position: sticky;
			top: 0;
			z-index: 10;
			background: color-mix(in srgb, var(--bg) 82%, transparent);
			backdrop-filter: blur(10px);
			-webkit-backdrop-filter: blur(10px);
			border-bottom: 1px solid var(--border);
		}
		.nav-inner {
			max-width: 80rem;
			margin: 0 auto;
			padding: 0.6rem 1.5rem;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
		}
		.brand {
			display: inline-flex;
			align-items: center;
			gap: 0.55rem;
			font-weight: 700;
			font-size: 1.05rem;
			color: var(--text);
			letter-spacing: -0.01em;
		}
		.brand:hover { text-decoration: none; }
		.brand img { width: 24px; height: 24px; border-radius: 6px; }
		.nav-links { display: flex; align-items: center; gap: 1.4rem; }
		.nav-links a {
			color: var(--muted);
			font-size: 0.92rem;
			font-weight: 500;
		}
		.nav-links a:hover { color: var(--text); text-decoration: none; }
		.nav-links a.active { color: var(--brand-strong); font-weight: 650; }
		@media (max-width: 640px) {
			.nav-links { gap: 0.9rem; }
			.nav-links a { font-size: 0.85rem; }
		}

		/* -------------------------------------------------------- buttons -- */
		.button {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			padding: 0.55rem 1.15rem;
			border: 1px solid var(--border);
			border-radius: 0.6rem;
			background: var(--surface);
			color: var(--text);
			font-size: 0.95rem;
			font-weight: 600;
			box-shadow: var(--shadow);
			transition: border-color 0.15s ease, transform 0.1s ease;
		}
		.button:hover { text-decoration: none; border-color: var(--muted); transform: translateY(-1px); }
		.button.primary { background: var(--brand); border-color: var(--brand); color: var(--brand-ink); }
		.button.primary:hover { border-color: #d9a94f; }
		.button.small { padding: 0.3rem 0.8rem; font-size: 0.85rem; box-shadow: none; }

		/* --------------------------------------------------------- layout -- */
		.container { max-width: 80rem; margin: 0 auto; padding: 0 1.5rem; }
		.section { padding: 4.5rem 0; border-top: 1px solid var(--border); }
		.eyebrow {
			margin: 0 0 0.6rem;
			font-size: 0.78rem;
			font-weight: 700;
			letter-spacing: 0.12em;
			color: var(--brand-strong);
		}
		.section-head { max-width: 44rem; margin-bottom: 2.5rem; }
		.section-head h2 {
			margin: 0 0 0.7rem;
			font-size: clamp(1.6rem, 3.5vw, 2.1rem);
			letter-spacing: -0.02em;
			line-height: 1.25;
		}
		.section-head p { margin: 0; color: var(--muted); }
		.lead { color: var(--muted); }

		/* --------------------------------------------------------- cards --- */
		.feature-grid {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.25rem;
		}
		@media (max-width: 900px) { .feature-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
		@media (max-width: 600px) { .feature-grid { grid-template-columns: minmax(0, 1fr); } }
		.feature-card {
			background: var(--surface);
			border: 1px solid var(--border);
			border-radius: 0.9rem;
			padding: 1.4rem 1.5rem;
			box-shadow: var(--shadow);
		}
		.feature-card h3 { margin: 0 0 0.5rem; font-size: 1.05rem; letter-spacing: -0.01em; }
		.feature-card h3 .glyph { color: var(--brand-strong); margin-right: 0.35rem; }
		.feature-card p { margin: 0; font-size: 0.92rem; line-height: 1.7; color: var(--muted); }

		/* --------------------------------------------------------- split --- */
		.split {
			display: grid;
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			gap: 3rem;
			align-items: center;
		}
		@media (max-width: 900px) { .split { grid-template-columns: minmax(0, 1fr); gap: 2rem; } }
		.split h3 { margin: 0 0 0.8rem; font-size: 1.45rem; letter-spacing: -0.015em; line-height: 1.3; }
		.split p { margin: 0 0 1rem; color: var(--muted); }
		.split ul { margin: 0; padding-left: 1.3rem; color: var(--muted); }
		.split li { margin: 0.35rem 0; }
		.split li::marker { color: var(--brand-strong); }

		/* ------------------------------------------------------- page hero - */
		.page-hero { padding: 4.5rem 0 2.5rem; }
		.page-hero h1 {
			margin: 0 0 0.8rem;
			font-size: clamp(2rem, 5vw, 2.8rem);
			letter-spacing: -0.025em;
			line-height: 1.2;
		}
		.page-hero p { margin: 0; max-width: 44rem; color: var(--muted); font-size: 1.1rem; }

		/* ---------------------------------------------------------- prose -- */
		.prose h2 {
			margin: 3.5rem 0 1rem;
			padding-bottom: 0.4rem;
			border-bottom: 1px solid var(--border);
			font-size: 1.65rem;
			letter-spacing: -0.015em;
			line-height: 1.25;
			scroll-margin-top: 5rem;
		}
		.prose h2:first-of-type { margin-top: 0; }
		.prose h3 { margin: 2.25rem 0 0.75rem; font-size: 1.2rem; letter-spacing: -0.01em; }
		.prose p { margin: 1rem 0; }
		.prose ul, .prose ol { margin: 1rem 0; padding-left: 1.5rem; }
		.prose li { margin: 0.4rem 0; }
		.prose li::marker { color: var(--brand-strong); font-weight: 700; }
		.prose .emo-terminal { margin: 1.4rem 0; }
		.prose .cli {
			margin: 1.4rem 0;
			padding: 1rem 1.25rem;
			border: 1px solid var(--border);
			border-radius: 0.75rem;
			background: #1a1a1c;
			color: #e8e8ec;
			font-family: var(--mono);
			font-size: 0.85rem;
			line-height: 1.7;
			overflow-x: auto;
			white-space: pre;
		}
		.prose .cli .tok-c { color: #7a7a84; }
		.prose .cli .tok-p { color: #efbf6b; }

		/* --------------------------------------------------------- footer -- */
		.site-footer {
			border-top: 1px solid var(--border);
			padding: 2.5rem 1.5rem 3rem;
			text-align: center;
			color: var(--muted);
			font-size: 0.9rem;
		}
		.site-footer p { margin: 0.35rem 0; }
		.site-footer .footer-links { display: inline-flex; gap: 1.5rem; flex-wrap: wrap; justify-content: center; }
	</style>
}
